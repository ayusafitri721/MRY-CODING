<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Export PDF Teleferic</title>
  <% /* baseUrl is provided by server so relative assets (like /images/logo.png) load when Playwright renders page */ %>
  <% if (typeof baseUrl !== 'undefined' && baseUrl) { %>
  <base href="<%= baseUrl %>">
  <% } %>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap");
    body {
      font-family: "Plus Jakarta Sans", sans-serif;
      margin: 0;
      padding: 20px;
    }
    .pdf-container {
      max-width: 210mm; /* A4 width */
      margin: 0 auto;
      background: white;
    }
    .header {
      background: #f9a825;
      padding: 15px 20px;
      color: black;
      border-radius: 5px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .logo-container {
      background: white;
      padding: 15px;
      border-radius: 10px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .logo {
      height: 80px;
      width: auto;
      display: block;
    }
    .header-content {
      flex-grow: 1;
      padding-top: 10px;
    }
    .title {
      margin: 0;
      font-size: 20px;
      font-weight: bold;
      text-align: left;
      letter-spacing: 0.5px;
    }
    .subtitle {
      margin: 4px 0;
      font-size: 16px;
      text-align: left;
      font-weight: 700;
    }
    .date {
      margin: 8px 0 0;
      font-size: 18px;
      opacity: 0.9;
      text-align: left;
    }
    .total-layanan {
      text-align: center;
      margin: 15px 0;
      font-size: 18px;
      font-weight: bold;
      padding: 10px;
      color: black;
      background: #f9a825;
      letter-spacing: 0.5px;
      border-radius: 5px;
    }
    .table-container {
      display: flex;
      gap: 20px;
      margin-top: 10px;
      min-height: auto;
    }
    .table-column {
      flex: 1;
      max-height: none;
    }
    .table-scroll {
      max-height: none;
      overflow: visible;
    }
    th,
    td {
      padding: 4px 8px;
      border: 1px solid #f9a825;
      line-height: 1.2;
    }
    th {
      background: #f9a825;
      color: black;
      font-weight: 600;
      font-size: 11px;
      text-transform: uppercase;
      text-align: center;
    }
    .no-column {
      width: 30px;
      text-align: center;
    }
    td:nth-child(1) {
      font-size: 11px;
      width: 10%;
      text-align: center;
    }
    td:nth-child(2) {
      font-weight: 500;
      font-size: 11px;
      width: 35%;
      padding-left: 8px;
    }
    td:nth-child(3) {
      font-size: 10px;
      width: 20%;
      text-align: center;
    }
    td:nth-child(4) {
      font-size: 11px;
      width: 15%;
      text-align: right;
      padding-right: 8px;
    }
    td:nth-child(5) {
      font-size: 10px;
      width: 10%;
      text-align: center;
    }
    td:nth-child(6) {
      font-size: 10px;
      width: 10%;
      text-align: center;
    }
    tr:nth-child(even) {
      background: #fff8e1;
    }

    .page-break {
      page-break-before: always;
    }
  </style>
</head>

<body>
  <div class="pdf-container" id="pdfContent">
    <% const paketData=(typeof paket !=='undefined')?paket:(typeof paketInfo!=='undefined'?paketInfo:{}); %>
    <div class="header">
      <div class="logo-container">
        <% if (paketData && paketData.logoUrl) { %>
          <img src="<%= paketData.logoUrl %>" alt="logo" class="logo" />
        <% } else if (typeof logoBase64 !== 'undefined' && logoBase64) { %>
          <img src="data:image/png;base64,<%= logoBase64 %>" alt="logo" class="logo" />
        <% } else { %>
          <img src="/images/logo.png" alt="Logo" class="logo" />
        <% } %>
      </div>
      <div class="header-content">
        <h1 class="title">DAFTAR ADD ON TELEFERIC</h1>
        <h2 class="subtitle">BERSAMA RAHMAH TRAVEL</h2>
        <p class="date">
          <%= paketData.nama_paket %> - <%= paketData.tanggal_keberangkatan ? new Date(paketData.tanggal_keberangkatan).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) : '-' %>
        </p>
      </div>
    </div>

    <% const entriesList = Array.isArray(entries)?entries:[]; %>
    <div class="total-layanan">
      Total Jamaah : <%= entriesList.length %> Orang
    </div>

    <%
      const itemsPerColumn = 20;
      const itemsPerPage = itemsPerColumn * 2; // 40 items per page
      const totalPages = Math.ceil(entriesList.length / itemsPerPage);

      // Helper function to format currency
      const formatRupiah = (num) => {
        if (!num || isNaN(Number(num))) return '-';
        return 'Rp ' + Number(num).toLocaleString('id-ID', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
      };

      // Helper function to format date
      const formatDate = (dateStr) => {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return '-';
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
      };
    %>

    <% for (let page = 0; page < totalPages; page++) { %>
    <%
      const pageStartIndex = page * itemsPerPage;
      const leftTableServices = entriesList.slice(pageStartIndex, pageStartIndex + itemsPerColumn);
      const rightTableServices = entriesList.slice(pageStartIndex + itemsPerColumn, pageStartIndex + itemsPerPage);
    %>

    <div
      class="table-container <%= page > 0 ? 'page-break' : '' %>"
    >
      <!-- Left Table -->
      <div class="table-column">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="no-column">No</th>
                <th>Nama Jamaah</th>
                <th>Telepon</th>
                <th>Harga</th>
                <th>Status</th>
                <th>Tgl Input</th>
              </tr>
            </thead>
            <tbody>
              <% leftTableServices.forEach((e, index) => { %>
              <tr>
                <td class="no-column"><%= pageStartIndex + index + 1 %></td>
                <td><%= e && (e.nama_jamaah || e.nama_pemesan || e.nama_peserta) ? (e.nama_jamaah || e.nama_pemesan || e.nama_peserta) : '-' %></td>
                <td><%= e && (e.no_wa || e.nomor_wa || e.telepon || e.no_hp || e.nomor_whatsapp) ? (e.no_wa || e.nomor_wa || e.telepon || e.no_hp || e.nomor_whatsapp) : '-' %></td>
                <td style="text-align: right; padding-right: 8px;"><%= e && (e.harga_display || e.harga || e.harga_total) ? formatRupiah(e.harga_display || e.harga || e.harga_total) : '-' %></td>
                <td><%= e && (e.status || e.status_verifikasi) ? (e.status || e.status_verifikasi) : '-' %></td>
                <td><%= e && (e.tanggal_input || e.created_at) ? formatDate(e.tanggal_input || e.created_at) : '-' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right Table -->
      <% if (rightTableServices.length > 0) { %>
      <div class="table-column">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="no-column">No</th>
                <th>Nama Jamaah</th>
                <th>Telepon</th>
                <th>Harga</th>
                <th>Status</th>
                <th>Tgl Input</th>
              </tr>
            </thead>
            <tbody>
              <% rightTableServices.forEach((e, index) => { %>
              <tr>
                <td class="no-column">
                  <%= pageStartIndex + itemsPerColumn + index + 1 %>
                </td>
                <td><%= e && (e.nama_jamaah || e.nama_pemesan || e.nama_peserta) ? (e.nama_jamaah || e.nama_pemesan || e.nama_peserta) : '-' %></td>
                <td><%= e && (e.no_wa || e.nomor_wa || e.telepon || e.no_hp || e.nomor_whatsapp) ? (e.no_wa || e.nomor_wa || e.telepon || e.no_hp || e.nomor_whatsapp) : '-' %></td>
                <td style="text-align: right; padding-right: 8px;"><%= e && (e.harga_display || e.harga || e.harga_total) ? formatRupiah(e.harga_display || e.harga || e.harga_total) : '-' %></td>
                <td><%= e && (e.status || e.status_verifikasi) ? (e.status || e.status_verifikasi) : '-' %></td>
                <td><%= e && (e.tanggal_input || e.created_at) ? formatDate(e.tanggal_input || e.created_at) : '-' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- No client-side PDF generation here; server will render to PDF using Playwright -->
</body>
</html>